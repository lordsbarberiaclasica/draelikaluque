---
import FormularioValoracion from "../components/FormularioValoracion.astro";
import VideoDraModal from "../components/VideoDraModal.astro";
import Ga4Head from "../components/Ga4Head.astro";
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/open-sans/latin-400.css';
import '@fontsource/open-sans/latin-600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LandingHeader from '../components/LandingHeader.astro';
import LandingFooter from '../components/LandingFooter.astro';
import StickyCtaMobile from '../components/StickyCtaMobile.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** Imagen para compartir en redes (ruta absoluta desde /public) */
  ogImage?: string;
  /**
   * 'landing' usa header/footer mínimos sin navegación (L1–L6).
   * 'legal' usa el mismo header/footer mínimo, sin CTA fijo móvil (políticas).
   */
  variant?: 'site' | 'landing' | 'legal';
  /** Idioma de la página (por defecto español). */
  lang?: 'es' | 'en';
  /** URL de la versión en el otro idioma (hreflang), ruta absoluta desde la raíz. */
  alterna?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = '/images/hero-poster.jpg',
  variant = 'site',
  lang = 'es',
  alterna,
} = Astro.props;
const htmlLang = lang === 'en' ? 'en' : 'es-CO';
const ogLocale = lang === 'en' ? 'en_US' : 'es_CO';

const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alterna && (
      <>
        <link rel="alternate" hreflang={lang === 'en' ? 'en' : 'es'} href={canonical} />
        <link rel="alternate" hreflang={lang === 'en' ? 'es' : 'en'} href={new URL(alterna, SITE.url).href} />
      </>
    )}
    <link rel="preconnect" href="https://calendly.com" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Tag Manager (contenedor ya activo del sitio actual — lo administra Walter) -->
    <script is:inline define:vars={{ gtmId: SITE.gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>

    <!--
      [CRÍTICO] Captura y propagación de UTMs.
      1. Guarda utm_* + gclid/fbclid de la PRIMERA visita con UTM, como un
         conjunto completo, en localStorage por 30 días desde esa visita (más
         la página de entrada). Las visitas siguientes no lo sobrescriben.
         Además guarda la ÚLTIMA visita pagada (gclid/fbclid o utm_medium de
         pago) en "el_ult_*". Los formularios lo leen con src/scripts/utms.ts.
      4. window.elEnviarLead(): envío confiable a /api/lead.php (lee la
         respuesta, reintenta y avisa al dataLayer si falla, sin datos personales).
      2. Decora todos los enlaces a Calendly con esos parámetros.
      3. Anota el mensaje prellenado de WhatsApp con [ref:fuente|campaña].
      Sin esto no se sabe qué anuncio trae a cada paciente.
    -->
    <script is:inline>
      (function () {
        var KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'];
        var PREFIX = 'el_';
        var TTL = 30 * 24 * 60 * 60 * 1000; // 30 días

        try {
          var borrar = function () {
            KEYS.concat(['ts', 'landing']).forEach(function (k) { localStorage.removeItem(PREFIX + k); });
          };
          var ts = parseInt(localStorage.getItem(PREFIX + 'ts') || '0', 10);
          if (ts && Date.now() - ts > TTL) borrar();
          /* v2 = primera visita. Lo guardado con la lógica anterior (última
             visita, por claves sueltas) se conserva como punto de partida. */
          if (localStorage.getItem(PREFIX + 'v') !== '2') {
            localStorage.setItem(PREFIX + 'v', '2');
            if (!localStorage.getItem(PREFIX + 'ts')) borrar();
          }
          var q = new URLSearchParams(location.search);
          var traeUtm = KEYS.some(function (k) { return q.get(k); });
          var hayGuardado = KEYS.some(function (k) { return localStorage.getItem(PREFIX + k); });
          if (traeUtm && !hayGuardado) {
            KEYS.forEach(function (k) {
              var v = q.get(k);
              if (v) localStorage.setItem(PREFIX + k, v);
              else localStorage.removeItem(PREFIX + k);
            });
            localStorage.setItem(PREFIX + 'ts', String(Date.now()));
            localStorage.setItem(PREFIX + 'landing', location.pathname);
          }
          /* Última visita PAGADA: se reemplaza completa en cada clic de anuncio. */
          var medio = (q.get('utm_medium') || '').toLowerCase();
          var esPago = q.get('gclid') || q.get('fbclid') || /cpc|ppc|paid|display|ads/.test(medio);
          if (esPago) {
            KEYS.forEach(function (k) {
              var v = q.get(k);
              if (v) localStorage.setItem(PREFIX + 'ult_' + k, v);
              else localStorage.removeItem(PREFIX + 'ult_' + k);
            });
            localStorage.setItem(PREFIX + 'ult_ts', String(Date.now()));
            localStorage.setItem(PREFIX + 'ult_landing', location.pathname);
          }
        } catch (e) { /* almacenamiento no disponible */ }

        /* ── Envío confiable de leads ─────────────────────────────────────
           Devuelve una promesa con true (guardado) o false (no se pudo).
           3 intentos con espera creciente; 400/422 no se reintentan. Si todo
           falla, último recurso con sendBeacon. Eventos al dataLayer:
           lead_guardado / lead_envio_fallido (sin nombre, teléfono ni salud). */
        window.elEnviarLead = function (url, cuerpo, formulario) {
          var datos = cuerpo instanceof URLSearchParams ? cuerpo : new URLSearchParams(cuerpo);
          if (!datos.has('envio_id')) {
            datos.set('envio_id', Date.now().toString(36) + Math.random().toString(36).slice(2, 8));
          }
          var ev = function (nombre, extra) {
            window.dataLayer = window.dataLayer || [];
            var o = { event: nombre, formulario: formulario || datos.get('hoja') || '', pagina: location.pathname };
            for (var k in extra) o[k] = extra[k];
            window.dataLayer.push(o);
          };
          var esperas = [0, 1500, 4000];
          var intento = function (i) {
            return new Promise(function (r) { setTimeout(r, esperas[i]); }).then(function () {
              var ctl = 'AbortController' in window ? new AbortController() : null;
              var t = ctl ? setTimeout(function () { ctl.abort(); }, 8000) : null;
              return fetch(url, {
                method: 'POST', body: datos, keepalive: true, credentials: 'same-origin',
                signal: ctl ? ctl.signal : undefined,
              }).then(function (res) {
                if (t) clearTimeout(t);
                if (res.status === 204) return { ok: true };
                return res.json().catch(function () { return {}; }).then(function (j) {
                  return { ok: res.ok && j && j.ok === true, status: res.status };
                });
              }, function (err) {
                if (t) clearTimeout(t);
                return { ok: false, status: 0, motivo: err && err.name === 'AbortError' ? 'tiempo_agotado' : 'red' };
              });
            }).then(function (r) {
              if (r.ok) { ev('lead_guardado', { intentos: i + 1 }); return true; }
              var definitivo = r.status === 400 || r.status === 422;
              if (!definitivo && i + 1 < esperas.length) return intento(i + 1);
              var beacon = false;
              if (!definitivo && navigator.sendBeacon) {
                try { beacon = navigator.sendBeacon(url, datos); } catch (e) {}
              }
              ev('lead_envio_fallido', { motivo: r.motivo || ('http_' + r.status), intentos: i + 1, beacon: beacon ? 'si' : 'no' });
              return false;
            });
          };
          return intento(0);
        };

        function get(k) {
          try { return localStorage.getItem(PREFIX + k) || ''; } catch (e) { return ''; }
        }

        function decorate() {
          // Calendly: los utm_* se propagan como parámetros nativos
          document.querySelectorAll('a[href*="calendly.com"]').forEach(function (a) {
            try {
              var u = new URL(a.href);
              KEYS.forEach(function (k) {
                var v = get(k);
                if (v && !u.searchParams.has(k)) u.searchParams.set(k, v);
              });
              a.href = u.toString();
              a.target = '_blank';
              a.rel = 'noopener';
            } catch (e) {}
          });
          // WhatsApp: referencia legible para las asesoras
          document.querySelectorAll('a[href*="wa.me"], a[href*="api.whatsapp.com"]').forEach(function (a) {
            try {
              var u = new URL(a.href);
              var src = get('utm_source');
              var cmp = get('utm_campaign');
              if (src || cmp) {
                var text = u.searchParams.get('text') || '';
                var ref = ' [ref:' + (src || '-') + '|' + (cmp || '-') + ']';
                if (text.indexOf('[ref:') === -1) u.searchParams.set('text', text + ref);
                a.href = u.toString();
              }
            } catch (e) {}
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', decorate);
        } else {
          decorate();
        }
      })();
    </script>
  <Ga4Head />
</head>

  <body class="min-h-screen flex flex-col">
    <!-- GTM noscript -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    {variant === 'site' ? <Header /> : <LandingHeader lang={lang} />}

    <main class="flex-1">
      <slot />
    </main>

    {variant === 'site' ? <Footer /> : <LandingFooter lang={lang} />}
    {variant === 'landing' && <StickyCtaMobile />}
    <WhatsAppFloat raised={variant === 'landing'} />

    <!-- Revelado suave en scroll -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add('is-visible');
                io.unobserve(en.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  <FormularioValoracion />
<VideoDraModal />
</body>
</html>
