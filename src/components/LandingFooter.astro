---
import { SITE, URL_POLITICA_DATOS, URL_POLITICA_DATOS_EN } from '../config';
interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const year = new Date().getFullYear();
---

<footer class="bg-azul-950 text-marfil/70">
  <div class="wrap py-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
    <img src="/images/logo-el.png" alt="" width="34" height="34" class="h-8 w-8 object-contain" />
    <p class="text-center">
      {en
        ? 'The information on this page is for guidance only and does not replace a medical assessment.'
        : 'La información de esta página es orientativa y no reemplaza una valoración médica.'}
    </p>
    <p>
      © {year} {en ? 'Dr. Elika Luque' : SITE.name} ·
      <a href={en ? URL_POLITICA_DATOS_EN : URL_POLITICA_DATOS} class="underline hover:text-dorado">
        {en ? 'Privacy Policy' : 'Política de tratamiento de datos'}
      </a>
    </p>
  </div>
  <div class="wrap pb-6 flex justify-center border-t border-marfil/10 pt-5">
    <div class="flex flex-col items-center gap-2">
      <img src="/images/luque-media.png" alt="Luque Media - Healthcare Marketing" width="132" height="66" class="h-14 w-auto opacity-95" loading="lazy" />
      <p class="text-[0.68rem] tracking-wide text-marfil/50">
        {en ? 'Powered by Luque Media - Healthcare Marketing' : 'Impulsado por Luque Media - Healthcare Marketing'}
      </p>
    </div>
  </div>
</footer>
